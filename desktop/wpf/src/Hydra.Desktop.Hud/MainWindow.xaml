<Window x:Class="Hydra.Desktop.Hud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HYDRA // COMMAND TERMINAL"
        Width="1600"
        Height="900"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="90"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="70"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Panel}">
      <Grid Margin="20,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="HYDRA // COMMAND TERMINAL" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
          <TextBlock Text="ALPHA LEGION TACTICA COGITATOR — SMART HOME CONTROL" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Margin="0,0,30,0">
            <TextBlock Text="RUNTIME" Foreground="{StaticResource Muted}"/>
            <TextBlock Text="{Binding RuntimeState}" FontSize="18" Foreground="{StaticResource Accent}"/>
          </StackPanel>
          <StackPanel Margin="0,0,30,0">
            <TextBlock Text="VOICE" Foreground="{StaticResource Muted}"/>
            <TextBlock Text="{Binding VoiceState}" FontSize="18" Foreground="{StaticResource Text}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="LOCAL TIME" Foreground="{StaticResource Muted}"/>
            <TextBlock Text="{Binding CurrentTime}" FontSize="18" Foreground="{StaticResource Text}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="390"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <Border BorderBrush="{StaticResource AccentDim}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Panel}" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="SYSTEM MODULES" FontSize="16" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding Modules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource Panel2}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding State}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="REFRESH TELEMETRY" Command="{Binding RefreshCommand}"/>
          </StackPanel>
        </Border>

        <Border BorderBrush="{StaticResource AccentDim}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Panel}" Padding="14">
          <StackPanel>
            <TextBlock Text="QUICK CONTROL" FontSize="16" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
            <Button Content="VOICE ON" Command="{Binding ExecuteCommandCommand}" CommandParameter="voice on"/>
            <Button Content="VOICE OFF" Command="{Binding ExecuteCommandCommand}" CommandParameter="voice off"/>
            <Button Content="SYSTEM STATUS" Command="{Binding RefreshCommand}"/>
            <Button Content="CLEAR LOGS" Command="{Binding ClearLogsCommand}"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <Grid Grid.Column="1" Margin="14,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Panel}" Padding="16">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="AI / COMMAND CHANNEL" FontSize="16" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding Conversation}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"/>
          </DockPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="{StaticResource AccentDim}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Panel}" Padding="16" Margin="0,12,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="RUNTIME LOG" FontSize="16" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" FontSize="11"/>
          </DockPanel>
        </Border>
      </Grid>

      <StackPanel Grid.Column="2">
        <Border BorderBrush="{StaticResource AccentDim}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Panel}" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="VOICE RUNTIME" FontSize="16" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="State" Foreground="{StaticResource Muted}" Margin="0,14,0,2"/>
            <TextBlock Text="{Binding VoiceState}" FontSize="20"/>
            <TextBlock Text="Wake word: OMEGON" Margin="0,12,0,0"/>
            <TextBlock Text="STT: Whisper"/>
            <TextBlock Text="TTS: HYDRA Voice"/>
            <TextBlock Text="DSP: Tactical profile"/>
          </StackPanel>
        </Border>

        <Border BorderBrush="{StaticResource AccentDim}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Panel}" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="AI PROVIDER" FontSize="16" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="{Binding AiProvider}" FontSize="18" Margin="0,12,0,4"/>
            <TextBlock Text="OpenAI / Gemini / Ollama / LM Studio" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border BorderBrush="{StaticResource AccentDim}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Panel}" Padding="14">
          <StackPanel>
            <TextBlock Text="SMART HOME" FontSize="16" Foreground="{StaticResource Accent}"/>
            <TextBlock Text="MQTT" Margin="0,12,0,0"/>
            <TextBlock Text="TUYA"/>
            <TextBlock Text="TAPO"/>
            <TextBlock Text="BLE"/>
            <TextBlock Text="HOME ASSISTANT"/>
            <TextBlock Text="Device bindings pending" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Panel}" Padding="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" FontSize="15" VerticalContentAlignment="Center"/>
        <Button Grid.Column="1" Content="EXECUTE" Command="{Binding ExecuteCommandCommand}" Margin="10,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
