<Window x:Class="Hydra.Desktop.Hud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HYDRA // COMMAND TERMINAL" Height="900" Width="1600"
        MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCoreBrush}">

  <Grid>
    <!-- Tactical grid background -->
    <Grid.Background>
      <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute" Opacity="0.08">
        <DrawingBrush.Drawing>
          <GeometryDrawing Brush="{StaticResource AccentDimBrush}">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <LineGeometry StartPoint="0,0" EndPoint="40,0"/>
                <LineGeometry StartPoint="0,0" EndPoint="0,40"/>
              </GeometryGroup>
            </GeometryDrawing.Geometry>
            <GeometryDrawing.Pen>
              <Pen Brush="{StaticResource AccentDimBrush}" Thickness="0.5"/>
            </GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingBrush.Drawing>
      </DrawingBrush>
    </Grid.Background>

    <Grid Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- TOP RAIL -->
      <Border Grid.Row="0" Style="{StaticResource HydraPanelAccent}" Padding="20,14" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="HYDRA // COMMAND TERMINAL" Style="{StaticResource HudHeader}"/>
            <TextBlock Text="ALPHA LEGION TACTICA COGITATOR — SMART HOME CONTROL" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" FontFamily="{StaticResource MonoFont}"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel Margin="0,0,32,0">
              <TextBlock Text="RUNTIME" Style="{StaticResource HudLabel}"/>
              <TextBlock Text="{Binding RuntimeState}" Style="{StaticResource HudValue}" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
            <StackPanel Margin="0,0,32,0">
              <TextBlock Text="VOICE" Style="{StaticResource HudLabel}"/>
              <TextBlock Text="{Binding VoiceState}" Style="{StaticResource HudValue}"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="LOCAL TIME" Style="{StaticResource HudLabel}"/>
              <TextBlock Text="{Binding CurrentTime}" Style="{StaticResource HudValue}" FontFamily="{StaticResource MonoFont}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- MAIN WORKSPACE -->
      <Grid Grid.Row="1" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <!-- EQUIPMENT TREE / SYSTEM MODULES -->
        <Border Grid.Column="0" Style="{StaticResource HydraPanel}" Margin="0,0,16,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="EQUIPMENT TREE" Style="{StaticResource HudTitle}"/>
            <ItemsControl ItemsSource="{Binding Modules}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource BgPanel2Brush}" CornerRadius="4" Padding="12,10" Margin="0,0,0,8" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding State}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="12">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Online}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>

        <!-- CENTER: COMMAND WHEEL + CONSOLE -->
        <Grid Grid.Column="1" Margin="0,0,16,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
          </Grid.RowDefinitions>

          <!-- COMMAND WHEEL -->
          <Border Grid.Row="0" Style="{StaticResource HydraPanelAccent}" Margin="0,0,0,16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="COMMAND WHEEL" Style="{StaticResource HudTitle}"/>

              <!-- Simulated radial wheel -->
              <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                <Ellipse Width="220" Height="220" Stroke="{StaticResource AccentDimBrush}" StrokeThickness="2" Fill="Transparent"/>
                <Ellipse Width="180" Height="180" Stroke="{StaticResource AccentDimBrush}" StrokeThickness="1" StrokeDashArray="4,4" Fill="Transparent"/>
                <Ellipse Width="80" Height="80" Fill="{StaticResource BgPanel2Brush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2">
                  <Ellipse.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="16" Color="{StaticResource HydraAccentPrimary}" Opacity="0.5"/>
                  </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="HYDRA" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="14"/>

                <!-- Wheel sectors -->
                <Button Content="DEVICES" Width="90" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Command="{Binding WheelDevicesCommand}"/>
                <Button Content="VOICE" Width="90" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Command="{Binding WheelVoiceCommand}"/>
                <Button Content="AI" Width="90" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Command="{Binding WheelAiCommand}"/>
                <Button Content="SCENES" Width="90" Height="36" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Command="{Binding WheelScenesCommand}"/>
              </Grid>
            </Grid>
          </Border>

          <!-- CONSOLE PANEL -->
          <Border Grid.Row="1" Style="{StaticResource HydraPanel}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="AI / COMMAND CHANNEL" Style="{StaticResource HudTitle}"/>
              <ListBox Grid.Row="1" ItemsSource="{Binding Conversation}" Margin="0,0,0,10">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="IsSelected" Value="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver, Mode=OneWay}"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border Background="{TemplateBinding Background}" Padding="4,2">
                            <ContentPresenter/>
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
              <TextBlock Grid.Row="2" Text="{Binding AiProvider}" FontSize="12" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
        </Grid>

        <!-- RIGHT: VOICE + AI PROVIDER + SMART HOME -->
        <StackPanel Grid.Column="2">
          <!-- VOICE STATUS -->
          <Border Style="{StaticResource HydraPanel}">
            <StackPanel>
              <TextBlock Text="VOICE RUNTIME" Style="{StaticResource HudTitle}"/>
              <TextBlock Text="State" Style="{StaticResource HudLabel}"/>
              <TextBlock Text="{Binding VoiceState}" FontSize="22" FontWeight="Bold" Margin="0,2,0,14">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource HudValue}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding VoiceState}" Value="LISTENING">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        <Setter Property="Effect" Value="{StaticResource AccentGlow}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="Wake word: OMEGON" FontSize="12"/>
              <TextBlock Text="STT: Whisper" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock Text="TTS: HYDRA Voice" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <TextBlock Text="DSP: Tactical profile" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </StackPanel>
          </Border>

          <!-- AI PROVIDER -->
          <Border Style="{StaticResource HydraPanel}">
            <StackPanel>
              <TextBlock Text="AI PROVIDER" Style="{StaticResource HudTitle}"/>
              <TextBlock Text="{Binding AiProvider}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBlock Text="OpenAI / Gemini / Ollama / LM Studio" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- SMART HOME -->
          <Border Style="{StaticResource HydraPanel}">
            <StackPanel>
              <TextBlock Text="SMART HOME" Style="{StaticResource HudTitle}"/>
              <TextBlock Text="MQTT" FontSize="12" Margin="0,0,0,4"/>
              <TextBlock Text="TUYA" FontSize="12" Margin="0,0,0,4"/>
              <TextBlock Text="TAPO" FontSize="12" Margin="0,0,0,4"/>
              <TextBlock Text="BLE" FontSize="12" Margin="0,0,0,4"/>
              <TextBlock Text="HOME ASSISTANT" FontSize="12" Margin="0,0,0,10"/>
              <TextBlock Text="Device bindings pending" Foreground="{StaticResource MutedBrush}" FontSize="11" FontStyle="Italic"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- COMMAND DOCK -->
      <Border Grid.Row="2" Style="{StaticResource HydraPanelAccent}" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" FontSize="15" VerticalContentAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
            <Button Content="EXECUTE" Command="{Binding ExecuteCommandCommand}" Width="120" Margin="0,0,8,0"/>
            <Button Content="CLEAR" Command="{Binding ClearLogsCommand}" Width="90"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>